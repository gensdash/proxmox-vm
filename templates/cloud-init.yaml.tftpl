#cloud-config
hostname: ${hostname}

users:
  - default
  - name: ${username}
    groups:
     - sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: truessh_authorized_keys:
%{ for key in ssh_authorized_keys ~}
        - ${key}
%{ endfor ~}

package_update: true
packages:
  - quemu-guest-agent
  - net-tools

time-zone: ${timezone}

runcmd:
  - [systemctl, enable, --now, quemu-guest-agent]
  - [mkdir, -p, /run/cloud-init]
  - [touch, /run/cloud-init/done]

final_message: "Cloud-init completed"
